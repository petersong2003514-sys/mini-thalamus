# Mini Thalamus — environment template
#
#   cp .env.example .env      # then fill in the keys you actually need
#
# Only the LLM key is required to start. Everything else has a working default,
# and every optional capability (search, sandbox, OCR, embeddings) degrades to
# "that agent is unavailable" rather than failing at startup.
#
# .env is read from $MT_ENV_FILE, then the current working directory, then the
# package directory; the first file to define a key wins, and real environment
# variables always take precedence over any of them.
#
# Naming: MT_* is this project's own namespace. Provider keys that belong to a
# third party (DEEPSEEK_*, TAVILY_*, NL2SQL_*) keep the vendor's own name.


# ─────────────────────────────────────────────────────────────────────────────
# LLM — required
# ─────────────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint works. DeepSeek is the default because it is
# what the committed benchmark runs used.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Alternative names accepted for the same three values, for deployments that
# already export OpenAI-style variables.
# OPENAI_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o


# ─────────────────────────────────────────────────────────────────────────────
# Vision — optional, falls back to the main LLM values above
# ─────────────────────────────────────────────────────────────────────────────
# VISION_API_KEY=
# VISION_BASE_URL=
# VISION_MODEL=


# ─────────────────────────────────────────────────────────────────────────────
# NL2SQL sub-agent
# ─────────────────────────────────────────────────────────────────────────────
# Defaults to the main LLM values. LIGHT_* drives the cheap path (schema
# selection, disambiguation); point it at a smaller model to cut cost.
# NL2SQL_API_KEY=
# NL2SQL_BASE_URL=
# NL2SQL_MODEL=deepseek-chat
# NL2SQL_LIGHT_API_KEY=
# NL2SQL_LIGHT_BASE_URL=
# NL2SQL_LIGHT_MODEL=


# ─────────────────────────────────────────────────────────────────────────────
# Router — the cascade is rules -> semantic -> LLM
# ─────────────────────────────────────────────────────────────────────────────
# A semantic match at or above THRESHOLD wins outright. Below it, a match is
# only trusted if it beats the runner-up by MARGIN; otherwise the cascade falls
# through. FALLBACK_THRESHOLD is the floor below which nothing is proposed.
# MT_ROUTER_SEMANTIC_THRESHOLD=0.78
# MT_ROUTER_SEMANTIC_MARGIN=0.12
# MT_ROUTER_SEMANTIC_FALLBACK_THRESHOLD=0.55
# MT_ROUTER_TOP_K=3

# "safe" (default) uses a dependency-free lexical matcher and never imports
# torch. "embedding" uses sentence-transformers — install the [semantic] extra.
# MT_SEMANTIC_BACKEND=safe
# MT_SEMANTIC_MODEL=paraphrase-multilingual-MiniLM-L12-v2


# ─────────────────────────────────────────────────────────────────────────────
# Web search — optional; without a key the websearch/deep_research agents are
# registered as unavailable
# ─────────────────────────────────────────────────────────────────────────────
# Comma/space separated preference order. Tried in order, then the rest of the
# built-ins: tavily, serper, bocha, searxng.
# MT_SEARCH_ENGINE=tavily
# MT_SEARCH_API_KEY=            # shared fallback for any of the providers
# TAVILY_API_KEY=
# SERPER_API_KEY=
# BOCHA_API_KEY=
# MT_SEARXNG_URL=               # self-hosted, needs no key

# Fall back to headless Chromium when a page returns no usable text.
# MT_WEB_FETCH_BROWSER=0
# MT_CHROMIUM_PATH=             # explicit browser binary, else Playwright's


# ─────────────────────────────────────────────────────────────────────────────
# API caller agent — third-party specs it is allowed to call
# ─────────────────────────────────────────────────────────────────────────────
# Defaults to the packaged data/api_specs/ directory.
# MT_API_SPECS_DIR=


# ─────────────────────────────────────────────────────────────────────────────
# Execution policy — what the approval checkpoint lets through
# ─────────────────────────────────────────────────────────────────────────────
# MT_AUTO_APPROVE=true          # true = the UI checkpoint auto-approves
# MT_ALLOW_LOCAL_EXECUTION=false  # run code on the host instead of the sandbox
# MT_SANDBOX_USE_DOCKER=false   # use Docker for the code sandbox
# MT_SANDBOX_IMAGE=python:3.11-slim
# SHELL_CONFIRM_MEDIUM=0        # 1 = also require approval for medium-risk commands


# ─────────────────────────────────────────────────────────────────────────────
# Reliability
# ─────────────────────────────────────────────────────────────────────────────
# MT_CIRCUIT_THRESHOLD=3        # consecutive failures before an agent trips
# MT_CIRCUIT_COOLDOWN=60        # seconds it stays tripped
# MT_REPLAN_ENABLED=true        # rewrite the downstream DAG after a failed step
# MT_REPLAN_MAX=2
# MT_SELF_EVAL=true             # judge "technically succeeded, goal missed"


# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
# MT_HOST=127.0.0.1
# MT_PORT=8765
# MT_RELOAD=false
# MT_API_KEY=                   # set to require auth; empty = local single user
# MT_RATE_LIMIT=30              # requests per minute per client


# ─────────────────────────────────────────────────────────────────────────────
# Optional integrations
# ─────────────────────────────────────────────────────────────────────────────
# MT_RAG_PROJECT=               # checkout path of an external RAG project;
#                               # empty = the rag agent reports unavailable
# PLAYWRIGHT_BROWSERS_PATH=     # where the browser extra installed Chromium


# ─────────────────────────────────────────────────────────────────────────────
# Environment quirks — only uncomment if you hit these
# ─────────────────────────────────────────────────────────────────────────────
# Two OpenMP runtimes in one process on Windows; needed when torch and pyarrow
# are both loaded by the semantic router.
# KMP_DUPLICATE_LIB_OK=TRUE
# PaddleOCR's model-source reachability check fails behind a slow mirror.
# PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
# MT_TAVILY_QUOTA=1000          # monthly cap the eval harness respects
