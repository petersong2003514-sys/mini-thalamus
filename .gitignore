# ---------------------------------------------------------------------------
# Secrets: never commit runtime credentials.
# ---------------------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*
**/credentials.json
**/credentials.enc
**/*credentials*backup*
# MCP server config is machine-specific (absolute paths to local tools);
# the .example file next to it documents the expected shape.
**/.mcp.json

# ---------------------------------------------------------------------------
# Archives and local delivery bundles.
# ---------------------------------------------------------------------------
*.zip

# ---------------------------------------------------------------------------
# Python / runtime artifacts.
# ---------------------------------------------------------------------------
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
.venv/
venv/
# Setuptools output from `pip install -e .` / `pip wheel .`.
build/
**/*.egg-info/
**/logs/
**/data/sessions/
**/data/uploads/
**/data/cache/
**/data/_ds_*.csv
**/data/memory.json
**/data/agent_memory.db*

# ---------------------------------------------------------------------------
# Frontend dependencies and builds.
# ---------------------------------------------------------------------------
**/node_modules/
**/dist/
**/.vite/

# ---------------------------------------------------------------------------
# Generated files and local tooling.
# ---------------------------------------------------------------------------
.worktrees/
**/static/generated/
**/.gradio/
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Personal agent-development memory (generated by project-dev-memory).
# Not project documentation; regenerated locally per developer.
# ---------------------------------------------------------------------------
.dev-memory/
AGENTS.md
CLAUDE.md

# ---------------------------------------------------------------------------
# Internal process artifacts (agent-generated plans/specs, not public docs).
# ---------------------------------------------------------------------------
**/docs/superpowers/

# ---------------------------------------------------------------------------
# Scratch, one-off patch scripts and exploration probes.
# ---------------------------------------------------------------------------
archive/
**/patch_*.py
**/probe_*.py
**/diag_*.py
**/_fix_*.py

# ---------------------------------------------------------------------------
# Evaluation outputs (regenerated by running the harness).
# Committed inputs live in evals/external/; these are run products.
# ---------------------------------------------------------------------------
**/evals/results/
**/evals/reports/
**/evals/self_evolution/applied/
**/evals/self_evolution/patches/
**/evals/self_evolution/reports/
**/evals/self_evolution/guard_results/

# ---------------------------------------------------------------------------
# Large benchmark corpora: fetched on demand by evals/download_*.py.
# Not committed — 150 MB+ combined.
# ---------------------------------------------------------------------------
# Note the trailing "/*": excluding the directory itself would stop git from
# descending into it, which would make the negations below unreachable.
**/evals/external/beir_data/*
**/evals/external/spider_data/*
**/evals/external/gaia/*

# ...but always ship the provenance notes that document where the corpora
# come from and how to re-fetch them.
!**/evals/external/*/SOURCES.md
!**/evals/external/SOURCES.md
