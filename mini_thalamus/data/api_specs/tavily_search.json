{
  "name": "Tavily Search",
  "aliases": ["tavily search", "tavily 搜索", "实时搜索", "联网搜索"],
  "method": "POST",
  "url_template": "https://api.tavily.com/search",
  "headers": {
    "Authorization": "Bearer ${MT_SEARCH_API_KEY}",
    "Content-Type": "application/json"
  },
  "params_schema": {
    "query": {"type": "string"},
    "max_results": {"type": "integer", "default": 5},
    "include_answer": {"type": "boolean", "default": false}
  }
}
