{
  "name": "Tavily Crawl",
  "aliases": ["tavily crawl", "tavily 爬取", "爬取网站"],
  "method": "POST",
  "url_template": "https://api.tavily.com/crawl",
  "headers": {
    "Authorization": "Bearer ${SHUSHU_SEARCH_API_KEY}",
    "Content-Type": "application/json"
  },
  "params_schema": {
    "url": {"type": "string"},
    "max_depth": {"type": "integer", "default": 1},
    "max_urls": {"type": "integer", "default": 10}
  }
}
